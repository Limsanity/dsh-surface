{
  "name": "@lim324/dsh-surface",
  "description": "surface-fork plugin for the DSH Web GUI: continue a session in a lightweight NEW session seeded from the latest compaction checkpoint to a target turn (surface re-seed), implemented as a standalone bundle plugin with zero edits to the deepseek-harness packages.",
  "version": "0.1.6",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node lib/build.mjs",
    "prepublishOnly": "npm run build",
    "test": "node --test test/surface-seed.test.js",
    "test:runtime": "node test/runtime-validation.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
